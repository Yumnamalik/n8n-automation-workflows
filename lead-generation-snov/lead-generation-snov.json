      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn Snov's domain-emails response into one item per lead.\n// NOTE: Snov's exact field names can vary slightly by account/plan.\n// After running this once, click on this node's output and check the\n// real field names - adjust the lines below (d.xxx) if needed.\nconst response = $input.first().json;\n\nif (response.status === 'in_progress' || response.data === undefined) {\n  return [{ json: { email: '', note: 'Snov is still processing this search - increase the Wait node duration and try again', raw: response } }];\n}\n\nconst emails = (response.data && response.data.emails) || response.emails || [];\n\nconst leads = [];\nfor (const d of emails) {\n  leads.push({\n    json: {\n      email: d.email || d.value || '',\n      type: d.type || '',\n      sourcePage: d.sourcePage || d.source_page || '',\n      domain: (response.data && response.data.domain) || ''\n    }\n  });\n}\n\nif (leads.length === 0) {\n  return [{ json: { email: '', note: 'No emails found for this domain', raw: response } }];\n}\n\nreturn leads;"
      },
      "id": "9b36828f-b3f1-45b7-bf15-84906d4268ba",
      "name": "Format Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
