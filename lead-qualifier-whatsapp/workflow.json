    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": { \"type\": \"string\", \"enum\": [\"positive\", \"neutral\", \"negative\"] },\n    \"lead_score\": { \"type\": \"number\" },\n    \"reason\": { \"type\": \"string\" }\n  },\n  \"required\": [\"sentiment\", \"lead_score\", \"reason\"]\n}"
      },
      "id": "4b8ab6dd-77e1-4593-a895-e4a2daa8dc80",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -416,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify the sentiment of the message below as Positive, Neutral or Negative, and give it a lead_score from 0-100 (100 = very hot/ready to buy). Message:\n\n\"{{$json.message}}\"",
        "hasOutputParser": true
      },
      "id": "6e6ca4d9-02cf-4154-9d3a-1ef0e1ae228b",
      "name": "Classify Sentiment",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -560,
        192
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.output.sentiment}}",
                    "rightValue": "positive",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.output.sentiment}}",
                    "rightValue": "neutral",
                    "operator": {
                      "type": "string",
